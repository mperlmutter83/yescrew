{
  "redirects": [
    {
      "source": "/:year(\\d{4})/:month(\\d{2})/:day(\\d{2})/:slug",
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/about-us",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/contact-us",
      "permanent": true
    },
    {
      "source": "/apply",
      "destination": "/apply-to-risk-free-marketing",
      "permanent": true
    },
    {
      "source": "/category/:slug",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/author/:slug",
      "destination": "/blog",
      "permanent": true
    }
  ]
}
